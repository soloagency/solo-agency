# OS/editor noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Language/tool caches
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.cache/
.venv/
venv/

# Local maintainer tooling
deploy-soloagency.sh

# Local runtime/data generated by installed agencies
daily-content-pipeline/
solo-agency-local-collector/
backup/
backups/

# Logs and local environment/secrets
*.log
.env
.env.local
*.pem
*.key
provider_config.local.json
**/provider_config.local.json

# Session/backup copies anywhere (git history is the backup)
*_20[2-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9]-[0-9][0-9].*
*.bak

# Internal working docs — never ship to the public product repo
AUDIT_FINDINGS_*.md
*_HARDENING_PLAN.md
PROPOSED_ADDITIONS_*.md
TODO.md
handoff.md
# Agency-internal roadmap: distribution channels (messenger/comment). Stays on the
# operator's machine for future brains to absorb; must never reach the public repo.
outreach/docs/DISTRIBUTION_CHANNELS_PLAN.md

# Build artifacts — rebuilt by deploy-soloagency.sh every run; NOT committed.
# The collector-bridge binaries zip is ~11 MB and changes each build, so committing
# it repeatedly bloated .git to ~700 MB. Distribute binaries via GitHub Releases,
# not git. (Existing tracked copies were removed with `git rm --cached`.)
solo-agency-collector/dist/

# Keep the small, content-versioned playbook/skill zip packages committed.
!playbooks/skills/*.zip

# Local session handoffs. Four of these were committed despite the name and sat in the PUBLIC
# repo for weeks, publishing SSH key paths, an API-key file location and another product's
# deploy topology. They were removed from all 379 commits on 2026-09-06 — but they are still on
# disk, so `git add -A` re-adds them as new files and undoes that in one deploy.
HANDOFF_LOCAL*.md

# Animation/media working files live outside the repo (../soloagency-workfiles/).
# The published illustrations are the small ones in assets/ — nothing else belongs here.
/*.mp4
/*.wav
/*.py
/agency-loop-square-*.png
/agency-loop-animation-*
# Timestamped backup copies are never published.
**/backup/*.bak.*

# Backup copies of files without an extension (LICENSE, etc.) are never published.
LICENSE_[0-9]*
