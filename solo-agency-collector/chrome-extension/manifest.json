{
  "manifest_version": 3,
  "name": "Solo Agency Collector (source, do not load)",
  "version": "0.2.90",
  "minimum_chrome_version": "137",
  "description": "Template extension copied per client by scripts/prepare_client_extension.sh. Do not load this folder directly -- load the generated extensions/{client}_extension/ copy instead.",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "platforms/facebook/gql_intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "platforms/instagram/ig_intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "platforms/x/x_intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Solo Agency Collector (source, do not load)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
